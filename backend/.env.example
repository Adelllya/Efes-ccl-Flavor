# Flavor Tree — переменные окружения бэкенда.
#
#   cp .env.example .env      # и заполнить значения
#
# settings.py читает backend/.env сам, без сторонних пакетов. Формат: KEY=VALUE,
# строки с # — комментарии, кавычки необязательны. Пустое значение = переменная не задана.
# Реальное окружение главнее файла: если переменная уже задана в системе (systemd, Docker,
# панель хостинга), значение из .env её НЕ перезапишет.
# Файл .env в git не попадает (.gitignore). Настоящие секреты в .env.example не кладём.

# ── Django ──────────────────────────────────────────────────────────────────
# Секретный ключ: им подписаны сессии и токены сброса пароля.
# Сгенерировать:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Значение брать в кавычки: в ключе бывают символы # и $.
# Локально можно оставить пустым — подставится dev-ключ. При DJANGO_DEBUG=False с пустым
# или dev-ключом сервер не запустится (ImproperlyConfigured).
DJANGO_SECRET_KEY=

# Режим отладки: True — локальная разработка, False — прод. По умолчанию True.
DJANGO_DEBUG=True

# Домены, с которых принимаются запросы, через запятую. Пример: api.example.com,www.example.com
# При DEBUG=True пустое значение означает «любой хост». При DEBUG=False пустое значение
# означает «никакой» (400 на каждый запрос) — в проде заполнить обязательно.
DJANGO_ALLOWED_HOSTS=

# Адреса фронтенда, которым разрешён CORS, через запятую, со схемой и без слэша в конце.
# Пример: https://app.example.com
# localhost:4200 и localhost:3000 разрешены всегда; при DEBUG=True разрешены все источники.
CORS_ALLOWED_ORIGINS=

# ── Доступ к служебному API сомелье ─────────────────────────────────────────
# Токен для /api/admin/*, /api/seed/ и записи в /api/brands/, /api/flavor-notes/.
# Передаётся заголовком  Authorization: Bearer <токен>  или  X-Admin-Token: <токен>.
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пусто + DEBUG=True  → служебный API открыт, в лог пишется предупреждение (локальное демо).
# Пусто + DEBUG=False → по токену не пройти никому (403); работает только вход сотрудника Django.
FT_ADMIN_TOKEN=

# ── ИИ-сомелье ──────────────────────────────────────────────────────────────
# Ключ Anthropic API для POST /api/ai/. Без ключа эндпоинт отвечает 503 с понятным текстом,
# остальной API работает.
ANTHROPIC_API_KEY=

# ── База данных (необязательно) ─────────────────────────────────────────────
# По умолчанию SQLite (backend/db.sqlite3). Для PostgreSQL — одна строка DATABASE_URL
# либо набор DB_*. Логин и пароль в примере — заглушки.
# DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/flavor_tree
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Папка с каноническими данными data/*.json. По умолчанию ../data относительно backend/.
# FLAVOR_DATA_DIR=
