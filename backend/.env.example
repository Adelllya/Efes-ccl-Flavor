# Настройки бэкенда. Скопируйте в backend/.env и заполните.

# Локальная работа: страница отладки, раздача без https, любые адреса в локальной сети.
# На сервере эти две строки не нужны: без DJANGO_DEBUG отладка выключена.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# На сервере: секретный ключ Django (длинная случайная строка).
# DJANGO_SECRET_KEY=

# Ключ Anthropic. Пусто: чат отвечает вкусовым движком Flavor Tree без обращения к модели,
# фото блюд не распознаются, сорта к блюдам подбирает расчёт по правилам.
# В Anthropic Console для ключа стоит задать лимит расходов workspace: это жёсткая страховка.
ANTHROPIC_API_KEY=
# Модель Claude для сомелье, распознавания фото и подбора сортов.
# claude-sonnet-5 быстрая и недорогая; claude-opus-5 точнее и дороже.
FT_AI_MODEL=claude-opus-5
# Сколько ответов Claude в чате можно за сутки на весь сервис (по времени Алматы). Дальше отвечает вкусовой движок.
# 0 выключает Claude. Расход за сутки модератор видит в GET /api/ai/status/.
FT_AI_DAILY_LIMIT=300
# Дневные лимиты остальных платных обращений к ИИ (0 - без лимита): распознавание и подбор в панели, фото от гостей.
FT_AI_PANEL_DAILY_LIMIT=400
FT_AI_GUEST_DAILY_LIMIT=150
# Сколько секунд ждать модель. Должно быть меньше лимита функции Vercel (на Hobby 10 с), иначе гость получит 504.
FT_AI_TIMEOUT=8
# Адрес сайта (фронтенда) для QR-кодов столов, без слэша в конце, например https://<домен-фронта>.vercel.app.
# Пусто: локально QR ведёт на http://localhost:4200.
FT_PUBLIC_SITE_URL=
